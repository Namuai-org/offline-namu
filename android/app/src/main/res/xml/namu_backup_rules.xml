<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-001, API <= 30 (Auto Backup). Chats, journal, weights, migration backups and exports
     all live under these domains; files/no_backup (models, chat DB) is never backed up by the
     platform and is excluded again here through the "file" and "root" domains. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
